# Local model via Ollama — no paid API key needed. Point this at the
# Ollama endpoint the agent can reach: in Codespaces / dev, that's usually
# `http://localhost:11434`; in-cluster, run Ollama as its own Deployment
# and use its Service DNS name instead (agent/k8s/ollama.yaml).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Data sources the Investigator node queries (in-cluster Service DNS —
# these already exist from Project 1, nothing new to deploy for these two).
LOKI_BASE_URL=http://loki-gateway.monitoring.svc.cluster.local
PROMETHEUS_BASE_URL=http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090

# Namespace the agent is allowed to inspect. Kept narrow on purpose — see
# agent/k8s/serviceaccount-rbac.yaml for the matching read-only RBAC.
TARGET_NAMESPACE=httpbin

# Where the Reporter node writes its output artifact (Phase 2.3 decision:
# a file in the repo, not a Slack webhook).
REPORT_OUTPUT_DIR=./incident-reports

# agento11y (Grafana Agent Observability, née Sigil SDK) — Phase 3.
# No LLM API cost to track since we're on local Ollama, but latency and
# generation counts still show up in the Grafana AI Observability view.
# Leave AGENTO11Y_ENDPOINT empty to run with instrumentation disabled.
# The SDK exports over gRPC by default; set AGENTO11Y_PROTOCOL=http for an
# HTTP ingest endpoint, and AGENTO11Y_AUTH_* if your backend needs auth.
AGENTO11Y_ENDPOINT=
AGENTO11Y_SERVICE_NAME=aiops-investigator-agent

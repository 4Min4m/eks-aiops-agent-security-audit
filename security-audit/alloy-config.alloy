// Grafana Alloy config (River syntax) — Phase 1 of the AIOps project.
//
// EKS control-plane audit logs land in CloudWatch Logs (log group
// "/aws/eks/<cluster-name>/cluster", log stream prefix "kube-apiserver-audit-")
// once you enable "audit" as a control-plane log type on the cluster (this
// is an EKS API/console setting — aws eks update-cluster-config
// --logging '{"clusterLogging":[{"types":["audit"],"enabled":true}]}').
//
// Alloy receives them via a Firehose HTTP endpoint, filters down to the two event categories the audit-policy.yaml above is
// designed to surface, and forwards structured entries to Loki.

logging {
  level = "info"
}

// --- Source: EKS control-plane audit log group in CloudWatch -------------
// Delivery path: CloudWatch Logs subscription filter on the audit log group
// -> Kinesis Data Firehose (HTTP endpoint destination) -> this receiver.
// loki.source.awsfirehose decodes the CloudWatch-subscription record format,
// so each audit event arrives as one JSON log line. See
// security-audit/README.md for the AWS-side setup.
loki.source.awsfirehose "eks_audit" {
  // Firehose sends this key in X-Amz-Firehose-Access-Key; requests without
  // it are rejected. Provided via env from a Secret (see gitops/alloy.yaml).
  access_key = sys.env("FIREHOSE_ACCESS_KEY")

  http {
    listen_address = "0.0.0.0"
    listen_port     = 9880
  }
  forward_to = [loki.process.filter_audit_events.receiver]
}

// --- Filter: keep only RBAC writes and pods/exec|attach -----------------
// EKS ships *every* audit event to CloudWatch (the audit-policy.yaml in this
// folder can't be handed to the managed apiserver), so this stage is what
// actually implements that policy.
//
// Note: Alloy regexes are Go RE2 — no lookahead/negation — so "keep only X"
// is expressed as: build a key, promote it to a temporary label, and drop
// lines whose key does NOT match (`!~` in a stage.match selector).
loki.process "filter_audit_events" {
  stage.json {
    expressions = {
      verb           = "verb",
      object_ref_res = "objectRef.resource",
      subresource    = "objectRef.subresource",
    }
  }

  // "<resource>/<subresource>/<verb>", e.g. "rolebindings//create" or
  // "pods/exec/create". Missing fields render as "<no value>".
  stage.template {
    source   = "audit_key"
    template = "{{ .object_ref_res }}/{{ .subresource }}/{{ .verb }}"
  }

  stage.static_labels {
    values = { pipeline = "k8s-audit" }
  }

  stage.labels {
    values = { audit_key = "" }
  }

  stage.match {
    // exec/attach: any verb (kubectl >= 1.30 uses WebSockets, which can be
    // audited as "get" rather than "create").
    selector            = "{pipeline=\"k8s-audit\", audit_key!~\"(roles|rolebindings|clusterroles|clusterrolebindings)/[^/]*/(create|update|patch|delete)|pods/(exec|attach)/.*\"}"
    action              = "drop"
    drop_counter_reason = "not_security_relevant"
  }

  // Low-cardinality labels the alerts and dashboard select on. The username
  // stays in the JSON log line (query it with `| json`), not as a label.
  stage.labels {
    values = {
      verb           = "",
      object_ref_res = "",
      subresource    = "",
    }
  }

  stage.label_drop {
    values = ["audit_key", "pipeline"]
  }

  forward_to = [loki.write.default.receiver]
}

// --- Sink: existing Grafana / Loki stack from Project 1 -------------------
loki.write "default" {
  endpoint {
    // Reuses the Loki instance deployed alongside Project 1's
    // kube-prometheus-stack Grafana (see security-audit/gitops/loki.yaml) —
    // deliberately not standing up a second Grafana per the plan.
    url = "http://loki-gateway.monitoring.svc.cluster.local/loki/api/v1/push"
  }
  external_labels = {
    cluster = "eks-httpbin-alb",
    source  = "k8s-audit",
  }
}
